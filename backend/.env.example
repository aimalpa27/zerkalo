# Copy to .env and fill in real values before running the server.

# Django core
SECRET_KEY=replace-with-a-long-random-string
DEBUG=False

# Comma-separated list of allowed hostnames (no spaces)
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# PostgreSQL (production). SQLite is used as fallback when this is absent.
DATABASE_URL=postgres://user:password@localhost:5432/qrcafe

# Redis — used for Django Channels (WebSocket) and throttle cache
REDIS_URL=redis://localhost:6379/0
CACHE_URL=redis://localhost:6379/1

# Comma-separated origins allowed by CORS (no spaces)
CORS_ALLOWED_ORIGINS=https://cafe-879cf.web.app,http://localhost:5173

# Cloudinary — хранение изображений блюд
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Sentry (опционально — если пусто, инициализация пропускается)
SENTRY_DSN=

# iiko Cloud API (iikoTransport, api-ru.iiko.services). app_id/client_secret —
# нашего приложения, общие. apiKey каждого ресторана хранится в БД (Restaurant,
# поле iiko_api_key из iikoWeb → «Настройки Cloud API»).
IIKO_API_BASE_URL=https://api-ru.iiko.services
IIKO_APP_ID=your-app-id
IIKO_CLIENT_SECRET=your-client-secret

# Django settings module override (development | production)
DJANGO_SETTINGS_MODULE=config.settings.development
# External AI features are intentionally disabled until explicitly enabled.
AI_ENABLED=false
